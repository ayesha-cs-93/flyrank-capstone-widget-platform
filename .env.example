# Database
DATABASE_URL=postgresql://widget_user:widget_pass@localhost:5432/widget_platform

# Geo enrichment providers (both free, no key required)
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# CORS - comma separated list of allowed origins for the submission endpoint
# use * for dev, lock down before showing this as "production"
ALLOWED_ORIGINS=*

# Toggle providers off manually for demo/testing fallback behavior
DISABLE_GEO_PROVIDER_A=false
DISABLE_GEO_PROVIDER_B=false
DISABLE_EMAIL_SIDE_EFFECT=false
